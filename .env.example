# Copie para .env (local) ou crie cada uma na Vercel: Settings > Environment Variables.
# Marque as chaves como Secret. Só as duas primeiras seções são obrigatórias.

# ---- Login (obrigatório)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORTAL_ALLOWED_EMAIL=voce@exemplo.com          # um ou mais, separados por vírgula
PORTAL_SESSION_SECRET=                          # 32+ caracteres aleatórios: openssl rand -hex 32
# PORTAL_BASE_URL=https://www.seusite.com       # só se o redirect do login falhar
# PORTAL_TZ=America/Sao_Paulo                   # fuso usado para "ontem" e os gráficos

# ---- Fontes (todas opcionais: cada uma liga quando a variável existe)
STRIPE_PORTAL_KEY=                              # chave restrita, só leitura: Charges, Checkout Sessions, Balance
GA4_SERVICE_ACCOUNT_JSON=                       # JSON inteiro da chave da conta de serviço
META_ACCESS_TOKEN=                              # token de usuário do sistema, ads_read
INSTAGRAM_ACCESS_TOKEN=                         # pode ser o mesmo do Meta, com permissões de Instagram
YOUTUBE_REFRESH_TOKEN=                          # gerado em /api/portal/auth/youtube
KIT_API_KEY=                                    # Kit > Settings > Developer > API keys (v4)
