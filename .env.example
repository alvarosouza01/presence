# Copy to .env (local) or create each one in Vercel: Settings > Environment Variables.
# Mark keys as Secret. Only the first section is required.

# ---- Login (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORTAL_ALLOWED_EMAIL=you@example.com            # one or more, comma separated
PORTAL_SESSION_SECRET=                          # 32+ random characters: openssl rand -hex 32
# PORTAL_BASE_URL=https://www.yoursite.com      # only if the login redirect fails
# PORTAL_TZ=America/New_York                    # time zone for "yesterday" and charts
# PORTAL_CURRENCY=usd                           # Stripe currency to total (usd, eur, brl…)

# ---- Sources (all optional: each one turns on when its variable exists)
STRIPE_PORTAL_KEY=                              # restricted, read-only key: Charges, Checkout Sessions, Balance
GA4_SERVICE_ACCOUNT_JSON=                       # full JSON of the service account key
META_ACCESS_TOKEN=                              # system user token, ads_read
INSTAGRAM_ACCESS_TOKEN=                         # can be the same as Meta, with Instagram permissions
YOUTUBE_REFRESH_TOKEN=                          # created at /api/portal/auth/youtube
KIT_API_KEY=                                    # Kit > Settings > Developer > API keys (v4)
